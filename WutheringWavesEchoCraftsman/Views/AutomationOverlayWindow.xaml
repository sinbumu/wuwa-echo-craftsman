<Window x:Class="WutheringWavesEchoCraftsman.Views.AutomationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동화 상태"
        Width="360"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SourceInitialized="Window_SourceInitialized">
    <StackPanel>
        <Border Padding="16"
                Margin="0,0,0,12"
                CornerRadius="16"
                Background="#CC111827"
                BorderBrush="#665B5FC7"
                BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Content="X"
                            Width="24"
                            Height="24"
                            Padding="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#334B5563"
                            BorderBrush="#667C83FF"
                            Click="CloseButton_Click" />
                    <TextBlock Text="현재 식별된 부옵션 목록"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="SubstatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#FFF9FAFB"
                                           FontSize="13" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ValueText}"
                                           Foreground="#FFC7D2FE"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptySubstatTextBlock"
                           Text="아직 인식된 부옵션이 없습니다."
                           Foreground="#FFD1D5DB"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <Border Padding="16"
                CornerRadius="16"
                Background="#CC111827"
                BorderBrush="#664B5563"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="이번 실행 히스토리"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <ItemsControl x:Name="HistoryItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="#FFE5E7EB"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyHistoryTextBlock"
                           Text="아직 잠금/폐기 기록이 없습니다."
                           Foreground="#FFD1D5DB"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
